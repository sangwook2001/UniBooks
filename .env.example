# Supabase 연결 정보 (Vercel/Supabase 프로젝트 설정에서 복사)
# v0 프로젝트의 Vars 메뉴 또는 Supabase 대시보드 > Project Settings > API 에서 확인할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) 로컬 개발 중 Supabase 이메일 인증 리다이렉트 URL
# 기본값은 http://localhost:3000/auth/callback 이 사용됩니다.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
